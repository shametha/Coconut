# Server only. Keep credentials out of source control.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GCLOUD_PROJECT=
COCONUT_HOURLY_AI_LIMIT=24
# Set to the public HTTPS origin when deployed behind a hosting proxy.
COCONUT_APP_ORIGIN=
# For local cloud access, use Application Default Credentials or a private local file.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/private-credentials.json
# Uncomment only when using the local emulator, with a demo- project ID above.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8086
